<!--
  Shared MSBuild settings for every project in the repository.
  Keep project files small: anything common belongs here.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML docs are reported by review, not by the compiler. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <Version>1.2.2</Version>
    <Product>Morfa</Product>
    <Authors>Morfa contributors</Authors>
    <Copyright>Copyright (c) Morfa contributors</Copyright>

    <!-- Single source of truth for the GitHub repository (used by the updater and the About page). -->
    <MorfaRepositoryUrl>https://github.com/nekonaru/morfa</MorfaRepositoryUrl>
    <RepositoryUrl>$(MorfaRepositoryUrl)</RepositoryUrl>
  </PropertyGroup>
</Project>
