<!--
  Morfa.Cli: the "morfa" command line. Converts files and watches folders without the tray app, with the same
  engines, presets and settings. Published next to Morfa.exe as morfa-cli.exe (one runtime for both); the installer
  puts a "morfa" shim on PATH (cli\morfa.cmd).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>morfa-cli</AssemblyName>
    <RootNamespace>Morfa.Cli</RootNamespace>
    <ApplicationIcon>..\Morfa.App\Assets\Icons\morfa.ico</ApplicationIcon>
    <!-- The Recycle Bin is IFileOperation, a COM interface (Morfa.Platform.Windows). -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Morfa.Core\Morfa.Core.csproj" />
    <ProjectReference Include="..\Morfa.Engines\Morfa.Engines.csproj" />
    <!-- "Replace the original" moves originals to the Recycle Bin / Trash (MoveToTrash), as the app does. -->
    <ProjectReference Include="..\Morfa.Platform.Windows\Morfa.Platform.Windows.csproj" />
    <ProjectReference Include="..\Morfa.Platform.Linux\Morfa.Platform.Linux.csproj" />
    <ProjectReference Include="..\Morfa.Platform.MacOS\Morfa.Platform.MacOS.csproj" />
  </ItemGroup>

  <!-- Error messages and built-in preset names, in English (the app's translation file). -->
  <ItemGroup>
    <EmbeddedResource Include="..\Morfa.App\Assets\i18n\en.json" LogicalName="Morfa.Cli.en.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Morfa.Cli.Tests" />
  </ItemGroup>
</Project>
