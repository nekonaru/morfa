// Version information of the Explorer context-menu DLL. build/build-explorer-menu.ps1 passes the app version as
// MORFA_VERSION_MAJOR/MINOR/PATCH and MORFA_VERSION_TEXT.

#include <winver.h>

#ifndef MORFA_VERSION_MAJOR
#define MORFA_VERSION_MAJOR 0
#define MORFA_VERSION_MINOR 0
#define MORFA_VERSION_PATCH 0
#define MORFA_VERSION_TEXT "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION MORFA_VERSION_MAJOR, MORFA_VERSION_MINOR, MORFA_VERSION_PATCH, 0
PRODUCTVERSION MORFA_VERSION_MAJOR, MORFA_VERSION_MINOR, MORFA_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Morfa contributors"
            VALUE "FileDescription", "Morfa File Explorer context menu"
            VALUE "FileVersion", MORFA_VERSION_TEXT
            VALUE "InternalName", "MorfaExplorerMenu"
            VALUE "LegalCopyright", "Copyright (c) Morfa contributors. MIT License."
            VALUE "OriginalFilename", "MorfaExplorerMenu.dll"
            VALUE "ProductName", "Morfa"
            VALUE "ProductVersion", MORFA_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
