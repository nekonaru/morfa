<!-- Main window: a single chrome band split into two rows (brand + groups + tools above, the group's pages below).
     Closing hides to the tray. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Morfa.Desktop.ViewModels"
        x:Class="Morfa.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Morfa"
        Icon="avares://Morfa/Assets/Icons/morfa.ico"
        Width="1080" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*">
    <!-- Two-row chrome band. Top: identity, page groups and tools. Bottom: the pages of the active group. -->
    <Border Grid.Row="0" Classes="chromeband">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,9" VerticalAlignment="Center">
          <!-- Identity -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,18,0">
            <Image Source="avares://Morfa/Assets/Icons/morfa.png" Width="30" Height="30" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Morfa" FontSize="17" FontWeight="Bold" />
              <TextBlock Classes="caption" Text="{DynamicResource app.tagline}" />
            </StackPanel>
          </StackPanel>
          <!-- Group pills -->
          <ListBox Grid.Column="1" x:Name="Groups" Classes="pill" VerticalAlignment="Center" HorizontalAlignment="Center"
                   ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=OneWay}"
                   SelectionChanged="OnGroupSelected">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavGroup">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="15" Height="15" Data="{Binding Icon}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- Tools -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="18,0,0,0">
            <Button x:Name="UpdateButton" Classes.accent="{Binding !Updates.IsOptional}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" Padding="10,6"
                    Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding Updates.IsUpdateAvailable}"
                    ToolTip.Tip="{Binding UpdateTip}">
              <DockPanel>
                <Border DockPanel.Dock="Right" CornerRadius="999" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                        Background="{DynamicResource DangerBrush}" IsVisible="{Binding Updates.IsRequired}">
                  <TextBlock Text="{DynamicResource update.pill.Required}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </Border>
                <Border DockPanel.Dock="Right" CornerRadius="999" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceAltBrush}" IsVisible="{Binding Updates.IsOptional}">
                  <TextBlock Classes="caption" Text="{DynamicResource update.pill.Optional}" FontSize="11" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Download}" />
                  <TextBlock Text="{Binding UpdateText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </Button>
            <Button Classes="navlink" Click="OnOpenGitHub" ToolTip.Tip="{Binding RepositoryUrl}">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <PathIcon Width="14" Height="14" Data="{StaticResource Icon.GitHub}" />
                <TextBlock Text="GitHub" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="navlink" Click="OnSponsor">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Heart}" Foreground="#D4537E" />
                <TextBlock Text="{DynamicResource about.sponsor}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock x:Name="VersionLabel" Classes="caption" VerticalAlignment="Center" Margin="2,0,0,0" Text="{Binding VersionText}" />
          </StackPanel>
        </Grid>
        <!-- The pages of the active group -->
        <Border Classes="subbar">
          <ListBox x:Name="SubNav" Classes="pill" Margin="16,8" ItemsSource="{Binding SubItems}" SelectedItem="{Binding SelectedItem, Mode=OneWay}"
                   SelectionChanged="OnSubPageSelected">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="15" Height="15" Data="{Binding Icon}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </StackPanel>
    </Border>

    <!-- Page -->
    <ScrollViewer Grid.Row="1" x:Name="PageScroller" VerticalScrollBarVisibility="{Binding PageScroll}">
      <ContentControl Classes="page" Content="{Binding CurrentPage}" Margin="32,18,32,26" MaxWidth="980" HorizontalAlignment="Stretch" />
    </ScrollViewer>
  </Grid>
</Window>
