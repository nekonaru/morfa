<!-- Main window (settings): top bar (brand, groups, downloads, version) + sub-page pills + current page. Closing hides to the tray. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Morfa.Desktop.ViewModels"
        x:Class="Morfa.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Morfa"
        Icon="avares://Morfa/Assets/Icons/morfa.ico"
        Width="1080" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*">
    <!-- Top bar: brand, page groups, and tools on the right (moved from the sidebar footer). -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,8" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0">
          <Image Source="avares://Morfa/Assets/Icons/morfa.png" Width="30" Height="30" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Morfa" FontSize="18" FontWeight="Bold" />
            <TextBlock Classes="caption" Text="{DynamicResource app.tagline}" />
          </StackPanel>
        </StackPanel>
        <!-- Group pills: pick a group, the row below shows its pages. -->
        <ListBox Grid.Column="1" x:Name="Groups" Classes="pill" VerticalAlignment="Center"
                 ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=OneWay}"
                 SelectionChanged="OnGroupSelected">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavGroup">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
          <!-- Accent for required and recommended updates, plain for optional ones; a pill says which -->
          <Button x:Name="UpdateButton" Classes.accent="{Binding !Updates.IsOptional}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding Updates.IsUpdateAvailable}"
                  ToolTip.Tip="{Binding UpdateTip}">
            <DockPanel>
              <Border DockPanel.Dock="Right" CornerRadius="999" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                      Background="{DynamicResource DangerBrush}" IsVisible="{Binding Updates.IsRequired}">
                <TextBlock Text="{DynamicResource update.pill.Required}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
              </Border>
              <Border DockPanel.Dock="Right" CornerRadius="999" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                      Background="{DynamicResource SurfaceAltBrush}" IsVisible="{Binding Updates.IsOptional}">
                <TextBlock Classes="caption" Text="{DynamicResource update.pill.Optional}" FontSize="11" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Download}" />
                <TextBlock Text="{Binding UpdateText}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DockPanel>
          </Button>
          <!-- The project on GitHub, and sponsoring it -->
          <Button Classes="navlink" HorizontalAlignment="Stretch" Click="OnOpenGitHub" ToolTip.Tip="{Binding RepositoryUrl}">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.GitHub}" />
              <TextBlock Text="GitHub" />
            </StackPanel>
          </Button>
          <Button Classes="navlink" HorizontalAlignment="Stretch" Click="OnSponsor">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Heart}" Foreground="#D4537E" />
              <TextBlock Text="{DynamicResource about.sponsor}" />
            </StackPanel>
          </Button>
          <TextBlock x:Name="VersionLabel" Classes="caption" VerticalAlignment="Center" Margin="4,0,0,0" Text="{Binding VersionText}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Sub-page pills of the selected group. -->
    <Border Grid.Row="1" Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
      <ListBox x:Name="SubNav" Classes="pill" Margin="16,7" ItemsSource="{Binding SubItems}" SelectedItem="{Binding SelectedItem, Mode=OneWay}"
               SelectionChanged="OnSubPageSelected">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:NavItem">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Data="{Binding Icon}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Page -->
    <ScrollViewer Grid.Row="2" x:Name="PageScroller" VerticalScrollBarVisibility="{Binding PageScroll}">
      <ContentControl Classes="page" Content="{Binding CurrentPage}" Margin="32,22,32,28" MaxWidth="980" HorizontalAlignment="Stretch" />
    </ScrollViewer>
  </Grid>
</Window>
