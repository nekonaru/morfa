<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Morfa.Desktop.ViewModels.Pages"
             xmlns:c="using:Morfa.Desktop.Controls"
             xmlns:v="using:Morfa.Desktop.Views"
             x:Class="Morfa.Desktop.Views.Pages.AboutPage"
             x:DataType="vm:AboutPageViewModel">
  <UserControl.Styles>
    <Style Selector="Expander#NoticesToggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="16">
    <TextBlock Classes="h1" Text="{DynamicResource about.title}" />

    <!-- Hero: what Morfa is, in one band. -->
    <Border Classes="tray" Padding="24,20">
      <StackPanel Orientation="Horizontal" Spacing="22">
        <Image Source="avares://Morfa/Assets/Icons/morfa.png" Width="84" Height="84" />
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="Morfa" FontSize="28" FontWeight="Bold" />
          <TextBlock Classes="muted" Text="{Binding Version}" />
          <TextBlock Classes="muted" Text="{DynamicResource about.license}" />
          <Button Classes="ghost" Padding="0" Click="OnOpenRepository" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Link}" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding RepositoryUrl}" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
          </Button>
          <!-- This version's "What's new" slides again -->
          <Button x:Name="WhatsNewLink" Classes="ghost" Padding="0" Command="{Binding ShowWhatsNewCommand}" IsVisible="{Binding HasWhatsNew}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Info}" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding WhatsNewText}" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="{DynamicResource about.updates}" />
        <ToggleSwitch Content="{DynamicResource general.check_updates}" IsChecked="{Binding CheckForUpdates}" />
        <WrapPanel>
          <Button Content="{DynamicResource general.check_now}" Command="{Binding CheckNowCommand}" Margin="0,0,10,0" />
          <Button Classes="accent" Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding UpdateAvailable}" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Download}" />
              <TextBlock Text="{Binding UpdateButtonText}" />
            </StackPanel>
          </Button>
          <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding UpdateStatus}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- The two sections, left to right: sponsors and support. -->
    <WrapPanel>
      <!-- The sponsors right below Morfa itself, while there are any -->
      <Border Classes="card" IsVisible="{Binding #Supporters.IsVisible}" Width="300" Margin="0,0,14,14" VerticalAlignment="Stretch">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{DynamicResource sponsor.thanks}" TextWrapping="Wrap" />
          <v:SupportersView x:Name="Supporters" ShowTitle="False" LogoHeight="40" />
        </StackPanel>
      </Border>
      <Border Classes="card" Width="300" Margin="0,0,14,14" VerticalAlignment="Stretch">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{DynamicResource about.support_title}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource about.support_text}" />
          <WrapPanel>
            <Button Classes="accent" Click="OnStar" Margin="0,0,8,8" Content="{DynamicResource feedback.star}" />
            <Button Click="OnIssue" Content="{DynamicResource feedback.issue}" Margin="0,0,8,8" />
            <Button Click="OnSponsor" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Heart}" Foreground="#D4537E" />
                <TextBlock Text="{DynamicResource about.sponsor}" />
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>
      </Border>
    </WrapPanel>

    <!-- The third-party notices: full width on every window, so the table fits without wrapping per character. -->
    <Border Classes="card" HorizontalAlignment="Stretch">
      <!-- The notices are in English: left to right in every language. -->
      <Expander x:Name="NoticesToggle" IsExpanded="False">
        <Expander.Header>
          <TextBlock Classes="h2" Text="{DynamicResource about.notices}" />
        </Expander.Header>
        <ScrollViewer MaxHeight="520" HorizontalScrollBarVisibility="Disabled">
          <c:MarkdownView Markdown="{Binding Notices}" SkipTitle="True" FlowDirection="LeftToRight" />
        </ScrollViewer>
      </Expander>
    </Border>
  </StackPanel>
</UserControl>
