<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Morfa.Desktop.ViewModels.Pages"
             xmlns:views="using:Morfa.Desktop.Views"
             xmlns:controls="using:Morfa.Desktop.Controls"
             x:Class="Morfa.Desktop.Views.Pages.PresetsPage"
             x:DataType="vm:PresetsPageViewModel">
  <ScrollViewer x:Name="EditorScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="380,20,*" controls:StackBelow.Threshold="900" controls:StackBelow.Gap="20"
          controls:StackBelow.Equally="True">
      <TextBlock Grid.ColumnSpan="2" Classes="h1" Text="{DynamicResource presets.title}" Margin="0,0,0,18" />

      <!-- Gallery: presets as cards, wraps and scrolls on its own. Two columns side by side on wide windows,
           stacked above the editor on narrow ones (StackBelow). -->
      <DockPanel Grid.Row="1">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button Classes="accent" Command="{Binding AddCommand}" Margin="0,0,6,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Plus}" />
              <TextBlock Text="{DynamicResource presets.add}" />
            </StackPanel>
          </Button>
          <Button x:Name="DuplicatePresetButton" Command="{Binding DuplicateCommand}" Margin="0,0,6,6"
                  ToolTip.Tip="{DynamicResource presets.duplicate}" AutomationProperties.Name="{DynamicResource presets.duplicate}">
            <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Copy}" />
          </Button>
          <Button x:Name="DeletePresetButton" Command="{Binding DeleteCommand}" Margin="0,0,6,6"
                  ToolTip.Tip="{DynamicResource presets.delete}" AutomationProperties.Name="{DynamicResource presets.delete}">
            <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Delete}" />
          </Button>
        </WrapPanel>
        <TextBox Classes="search clearButton" DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding Search}" Watermark="{DynamicResource common.search}">
              <TextBox.InnerLeftContent>
                <PathIcon Width="14" Height="14" Margin="10,0,0,0" Data="{StaticResource Icon.Search}" Foreground="{DynamicResource TextSecondaryBrush}" />
              </TextBox.InnerLeftContent>
        </TextBox>
        <ListBox Classes="soft" ItemsSource="{Binding VisiblePresets}" SelectedItem="{Binding SelectedPreset}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PresetListItem">
              <Border Classes="panel" Width="158" Height="64" Margin="0,0,8,8">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="caption" Text="{Binding Target}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Editor (same control as the donut's preset popup): scrolls on its own, Save stays visible below it -->
      <DockPanel Grid.Row="1" Grid.Column="2">
        <Border DockPanel.Dock="Bottom" Classes="card tray" Padding="12,10" Margin="0,12,0,0"
                IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <TextBlock Text="{Binding SavedMessage}" VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" />
            <Button Content="{DynamicResource presets.revert}" Command="{Binding RevertCommand}" />
            <Button Classes="accent" Content="{DynamicResource presets.save}" Command="{Binding SaveCommand}" />
          </StackPanel>
        </Border>
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,0,12,0">
            <TextBlock Classes="muted" Text="{DynamicResource presets.select}" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNull}}" />
            <views:PresetEditorView DataContext="{Binding Editor}" IsVisible="{Binding $parent[UserControl].((vm:PresetsPageViewModel)DataContext).Editor, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
