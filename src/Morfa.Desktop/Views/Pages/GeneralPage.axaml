<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Morfa.Desktop.ViewModels.Pages"
             xmlns:controls="using:Morfa.Desktop.Controls"
             x:Class="Morfa.Desktop.Views.Pages.GeneralPage"
             x:DataType="vm:GeneralPageViewModel">
  <Grid ColumnDefinitions="*,20,220" VerticalAlignment="Top" controls:StackBelow.Threshold="900" controls:StackBelow.Gap="16">
    <StackPanel Grid.Column="0" Spacing="16">
      <TextBlock Classes="h1" Text="{DynamicResource general.title}" />

      <!-- Language and system integration. -->
      <Border x:Name="SectionLanguage" Classes="card" IsVisible="{Binding #TocLanguage.IsChecked}">
        <StackPanel Spacing="12">
          <DockPanel>
            <TextBlock Classes="label" VerticalAlignment="Center" Margin="0" Text="{DynamicResource general.language}" />
            <ComboBox DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="240"
                      ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Classes="label" VerticalAlignment="Center" Margin="0" Text="{DynamicResource general.start_with_system}" />
            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartWithSystem}" />
          </DockPanel>
          <DockPanel IsVisible="{Binding SupportsDockVisibility}">
            <TextBlock Classes="label" VerticalAlignment="Center" Margin="0" Text="{DynamicResource general.show_in_dock}" />
            <ToggleSwitch x:Name="ShowInDockSwitch" DockPanel.Dock="Right" IsChecked="{Binding ShowInDock}" />
          </DockPanel>
          <DockPanel IsVisible="{Binding SupportsDockVisibility}">
            <TextBlock Classes="label" VerticalAlignment="Center" Margin="0" Text="{DynamicResource general.show_menu_bar_icon}" />
            <ToggleSwitch x:Name="ShowMenuBarIconSwitch" DockPanel.Dock="Right" IsChecked="{Binding ShowMenuBarIcon}" />
          </DockPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding DockStatus}"
                     IsVisible="{Binding DockStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <DockPanel>
            <TextBlock Classes="label" VerticalAlignment="Center" Margin="0" Text="{DynamicResource general.close_action}" />
            <ComboBox DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="240"
                      ItemsSource="{Binding CloseChoices}" SelectedItem="{Binding CloseChoice}" />
          </DockPanel>
          <DockPanel IsVisible="{Binding HasSystemIntegration}">
            <TextBlock Classes="label" VerticalAlignment="Center" Margin="0" Text="{Binding ContextMenuText}" />
            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ContextMenu}" />
          </DockPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding IntegrationMessage}"
                     IsVisible="{Binding IntegrationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <!-- Windows 11: optional top-level entry (needs one administrator prompt), see ExplorerMenuRegistration. -->
          <StackPanel Spacing="8" IsVisible="{Binding ShowModernMenu}">
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ModernMenuStatus}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{DynamicResource general.modern_menu_add}" Command="{Binding AddModernMenuCommand}" IsVisible="{Binding CanAddModernMenu}" />
              <Button Content="{DynamicResource general.modern_menu_remove}" Command="{Binding RemoveModernMenuCommand}" IsVisible="{Binding CanRemoveModernMenu}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Where presets set to "Default" save (AppSettings.DefaultOutput). -->
      <Border x:Name="SectionOutput" Classes="card" IsVisible="{Binding #TocOutput.IsChecked}">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{DynamicResource general.default_output}" />
          <DockPanel VerticalAlignment="Center">
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource general.default_output_hint}" MaxWidth="420" />
            <ComboBox DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="220"
                      ItemsSource="{Binding OutputLocations}" SelectedItem="{Binding DefaultLocation}" />
          </DockPanel>
          <StackPanel IsVisible="{Binding ShowDefaultSubfolder}">
            <TextBlock Classes="label" Text="{DynamicResource presets.subfolder}" />
            <TextBox Text="{Binding DefaultSubfolder}" PlaceholderText="converted" MaxWidth="420" HorizontalAlignment="Left" MinWidth="240" />
          </StackPanel>
          <StackPanel IsVisible="{Binding ShowDefaultFolder}">
            <TextBlock Classes="label" Text="{DynamicResource presets.custom_folder}" />
            <DockPanel MaxWidth="560" HorizontalAlignment="Stretch">
              <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource presets.browse}" Click="OnBrowseDefaultFolder" />
              <TextBox Text="{Binding DefaultFolder}" />
            </DockPanel>
          </StackPanel>
          <DockPanel>
            <TextBlock Classes="label" VerticalAlignment="Center" Margin="0" Text="{DynamicResource general.keep_dates}" />
            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding KeepFileDates}" />
          </DockPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource general.keep_dates_hint}" Margin="0,-6,0,0" />
          <DockPanel>
            <TextBlock Classes="label" VerticalAlignment="Center" Margin="0" Text="{DynamicResource general.zip_geo}" />
            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ZipGeoResults}" />
          </DockPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource general.zip_geo_hint}" Margin="0,-6,0,0" />
        </StackPanel>
      </Border>

      <!-- Pictures, links and downloads dragged out of a web browser (AppSettings.BrowserDrops). -->
      <Border x:Name="SectionDrops" Classes="card" IsVisible="{Binding #TocDrops.IsChecked}">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{DynamicResource general.browser_drops}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource general.browser_drops_hint}" />
          <DockPanel HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Classes="label" VerticalAlignment="Center" Margin="0" Text="{DynamicResource general.browser_drops_folder}" />
            <DockPanel DockPanel.Dock="Right" Margin="12,0,0,0">
              <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource presets.browse}" Click="OnBrowseBrowserFolder" />
              <TextBox Text="{Binding BrowserFolder}" PlaceholderText="{Binding DownloadsFolder}" Width="360" />
            </DockPanel>
          </DockPanel>
          <DockPanel>
            <TextBlock Classes="label" VerticalAlignment="Center" Margin="0" Text="{DynamicResource general.browser_drops_only_converted}" />
            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SaveOnlyConverted}"
                          AutomationProperties.Name="{DynamicResource general.browser_drops_only_converted}" />
          </DockPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource general.browser_drops_only_converted_hint}" Margin="0,-6,0,0" />
        </StackPanel>
      </Border>

      <Border x:Name="SectionHistory" Classes="card" IsVisible="{Binding #TocHistory.IsChecked}">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{DynamicResource general.history}" />
          <DockPanel>
            <TextBlock Classes="label" VerticalAlignment="Center" Margin="0" Text="{DynamicResource general.no_history}" />
            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding NoHistory}" />
          </DockPanel>
          <DockPanel IsVisible="{Binding !NoHistory}">
            <TextBlock Classes="label" VerticalAlignment="Center" Margin="0" Text="{DynamicResource general.history_limit}" />
            <NumericUpDown DockPanel.Dock="Right" Value="{Binding HistoryLimit}" Minimum="50" Maximum="2000" Increment="50" FormatString="0"
                           HorizontalAlignment="Left" MinWidth="160" />
          </DockPanel>
          <DockPanel>
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding HistoryText}" />
            <Button DockPanel.Dock="Right" Content="{DynamicResource general.clear_history}" Command="{Binding ClearHistoryCommand}" />
          </DockPanel>
        </StackPanel>
      </Border>

      <Border x:Name="SectionLibrary" Classes="card" IsVisible="{Binding #TocLibrary.IsChecked}">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{DynamicResource general.library}" />
          <DockPanel>
            <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding LibraryMessage}" MaxWidth="380" TextWrapping="Wrap" />
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="{DynamicResource general.export}" Click="OnExport" Margin="0,0,8,8" />
              <Button Content="{DynamicResource general.import}" Click="OnImport" Margin="0,0,8,8" />
              <Button Content="{DynamicResource general.reset_library}" Click="OnReset" Margin="0,0,8,8" />
            </WrapPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <Border x:Name="SectionDataFolder" Classes="card" IsVisible="{Binding #TocDataFolder.IsChecked}">
        <DockPanel>
          <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="{DynamicResource general.open_data_folder}" Command="{Binding OpenDataFolderCommand}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="label" Text="{DynamicResource general.data_folder}" />
            <TextBlock Text="{Binding DataFolder}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>

    <!-- Sticky table of contents: which sections show. -->
    <Border Grid.Column="2" Classes="panel" VerticalAlignment="Top">
      <StackPanel Spacing="4">
        <CheckBox x:Name="TocLanguage" IsChecked="True" Content="{DynamicResource general.language}" Margin="0,4" />
        <CheckBox x:Name="TocOutput" IsChecked="True" Content="{DynamicResource general.default_output}" Margin="0,4" />
        <CheckBox x:Name="TocDrops" IsChecked="True" Content="{DynamicResource general.browser_drops}" Margin="0,4" />
        <CheckBox x:Name="TocHistory" IsChecked="True" Content="{DynamicResource general.history}" Margin="0,4" />
        <CheckBox x:Name="TocLibrary" IsChecked="True" Content="{DynamicResource general.library}" Margin="0,4" />
        <CheckBox x:Name="TocDataFolder" IsChecked="True" Content="{DynamicResource general.data_folder}" Margin="0,4" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
